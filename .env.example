# Copy to backend/.env — every value below is optional.
# The service runs with no .env at all; these are the knobs, not requirements.

# --- Database ---------------------------------------------------------------
# Omit for zero-setup SQLite at backend/nutriai.db.
# DATABASE_URL=postgresql+psycopg://nutriai:nutriai@localhost:5432/nutriai

# --- Auth -------------------------------------------------------------------
# REQUIRED IN PRODUCTION. The default is a public constant; leaving it unset
# outside local development means anyone can mint a valid token.
JWT_SECRET=change-me-to-32-plus-random-bytes
JWT_TTL_SECONDS=2592000

# --- Nutrition --------------------------------------------------------------
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Without it, lookups fall back to the bundled Indian Food Composition Table.
USDA_API_KEY=
USDA_TIMEOUT_S=6.0

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=1600

# --- Pipeline tuning --------------------------------------------------------
DEFAULT_PLATE_DIAMETER_CM=26.0
LOW_CONFIDENCE_THRESHOLD=0.55
UNRECOGNIZED_THRESHOLD=0.28
MAX_ITEMS_PER_PLATE=6

# --- Model weights ----------------------------------------------------------
# Paths are auto-probed; each stage independently falls back to its classical
# implementation when the weights or the library are missing.
# YOLO_WEIGHTS=yolov8n.pt
# MIDAS_MODEL=MiDaS_small
# CLASSIFIER_CHECKPOINT=backend/models/efficientnet_v1.pt
# Set false to skip torch entirely (faster boot, heuristic engine only).
ENABLE_TORCH_MODELS=true

# --- Stage 4 over HTTP (recommended) ----------------------------------------
# The dish classifier is the only stage that needs torch, so it can be hosted
# separately — see model_api/ and TRAINING_LOG.md §5. With this set, the backend
# never imports torch for classification and runs comfortably on 512 MB.
# Unset is fine: it falls back to a local checkpoint, then to the colour/texture
# prior. Nothing here is required.
# CLASSIFIER_URL=https://your-name-nutri-ai-classifier.hf.space
# Must match the API_TOKEN set on the service. Without it the endpoint is open,
# and inference on someone else's free compute is a bill waiting to happen.
# CLASSIFIER_TOKEN=
# Generous on purpose: a sleeping free Space needs 30-60 s to cold-start.
# CLASSIFIER_TIMEOUT_S=25.0
# Original crop plus horizontal flip at inference. Set to 1 for lowest latency.
# CLASSIFIER_TTA_PASSES=2

# --- Serving ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
SERVE_FRONTEND=true
# Give a new account one pre-analysed sample meal so history and statistics
# have something to show on first launch. Set to false for a truly empty start.
SEED_WELCOME_MEAL=true
# UPLOAD_DIR=backend/uploads
# Training writes here; a container deploy usually mounts weights instead.
# MODEL_DIR=backend/models
